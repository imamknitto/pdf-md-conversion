# Copy to .env and adjust. All optional — defaults in app/config.py apply.
# Local dev: python -m uvicorn app.main:app --host 127.0.0.1 --port 8100
# Bearer token for /convert + /download. Empty = open (local dev only);
# always set in any shared/deployed environment. /health stays open.
CONVERTER_API_KEY=
PLATFORM_URL=http://127.0.0.1:5173
MAX_UPLOAD_MB=30
PUBLIC_TTL_MINUTES=60
PUBLIC_MAX_MB=1024
CLEANUP_INTERVAL_MINUTES=10
MIN_TEXT_CHARS=50
PAGE_COVERAGE=0.5
RECURRING_XREF_RATIO=0.5
IMAGE_MIN_AREA_RATIO=0.01
MAX_IMAGE_MB=10
MAX_IMAGES_PER_DOC=200
OCR_DPI=200
